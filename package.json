{
  "name": "brief-local-ai",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/ts-resolve.mjs --test tests/*.test.mjs",
    "prebuild": "expo prebuild",
    "video": "npm --prefix video run dev",
    "video:build": "npm --prefix video run build",
    "emulator": "bash scripts/start-emulator.sh",
    "record": "bash scripts/record-demo.sh"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@fugood/react-native-audio-pcm-stream": "1.1.4",
    "@kittentts/react-native": "1.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-ocr-kit": "^0.1.4",
    "expo-pdf-text-extract": "^1.1.0",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "llama.rn": "0.12.9",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "llama.rn@0.12.9": true,
    "@kittentts/react-native@1.2.0": true
  }
}

{
  "expo": {
    "name": "brief",
    "slug": "brief-app",
    "scheme": "brief",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brief.localai",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.brief.localai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8F5FF"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Brief uses the camera to scan job listings.",
          "microphonePermission": "Brief uses the microphone for spoken answers in mock interviews. Speech is transcribed on this phone; audio is never saved or uploaded.",
          "recordAudioAndroid": true
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-build-properties",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1677F2"
        }
      ],
      "expo-asset",
      "expo-audio"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark"
      },
      "eas": {
        "projectId": "90f07846-9897-46bc-b68e-fe04d81d825c"
      }
    }
  }
}

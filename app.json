{
  "expo": {
    "name": "brief",
    "slug": "brief-local-ai",
    "owner": "brief-app",
    "scheme": "brief",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brief.localai",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.brief.localai",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8F5FF"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Brief uses the camera to scan job listings.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-build-properties",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "9abd7ce0-d476-4f9a-951a-d9e7a36990d0"
      }
    }
  }
}

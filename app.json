{
  "expo": {
    "name": "brief",
    "slug": "brief-local-ai",
    "scheme": "brief",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brief.localai"
    },
    "android": {
      "package": "com.brief.localai",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E8F5FF"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-build-properties",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "icon": "./assets/icon.png"
  }
}
